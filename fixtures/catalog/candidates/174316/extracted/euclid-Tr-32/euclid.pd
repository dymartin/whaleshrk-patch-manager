#N canvas 715 164 661 614 10;
#X obj 107 181 inlet;
#X obj 49 349 outlet;
#X obj 162 235 inlet;
#X text 145 180 specify desired number of hits per bar;
#X text 208 232 specify length of bar;
#X text 88 116 <-- send an integer to find out if there should be a hit on that beat;
#X obj 49 252 % \$3;
#X text 48 429 Generates 'euclidean rhythms' (see cgm.cs.mcgill.ca/~godfried/publications/banff.pdf). Ideally to be used with a [metro]-powered [f ]x[+ 1] counter attached to the first inlet. Hits per bar \, offset and bar length can be set by the first three arguments respectively.;
#X obj 49 218 * \$1;
#X obj 49 285 < \$1;
#X obj 133 206 inlet;
#X text 175 205 rhythm offset/rotation;
#X obj 224 367 outlet;
#X obj 49 161 +;
#X obj 49 183 %;
#X obj 49 307 select 1;
#X text 28 11 This subpatch was created by the http://forum.pdpatchrepo.info user named 'Stutter', f 51;
#X text 28 42 For more information \, please visit: http://forum.pdpatchrepo.info/topic/5188/euclidean-rhythms/6;
#X obj 30 94 inlet;
#X connect 0 0 8 1;
#X connect 0 0 9 1;
#X connect 2 0 6 1;
#X connect 2 0 14 1;
#X connect 6 0 9 0;
#X connect 8 0 6 0;
#X connect 9 0 15 0;
#X connect 10 0 13 1;
#X connect 13 0 14 0;
#X connect 14 0 8 0;
#X connect 14 0 12 0;
#X connect 15 0 1 0;
#X connect 18 0 13 0;
